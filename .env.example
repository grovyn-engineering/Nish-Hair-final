# ==========================================
# NishHair Try-On Studio - Dokploy Environment Variables
# ==========================================

# Server Port & Binding (Required for Dokploy / Docker)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# TryItOn Developer API Key (Server-Side Secret)
# Get your API key from https://tryiton.now/app/developer
# Note: If left empty or set to "mock", the server API falls back to mock responses.
TRYITON_API_KEY=your_tryiton_api_key_here

