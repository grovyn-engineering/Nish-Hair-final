# ==========================================
# NishHair Try-On Studio - Environment Variables
# ==========================================

# Server Port & Binding (Required for Dokploy / Docker)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ==========================================
# Try-On Backend (Pick ONE option below)
# ==========================================

# Option 0 — VModel (google/nano-banana), checked first if set.
# Same API service used in the Velura project. Get a key at https://vmodel.ai
VMODEL_API_KEY=

# VModel needs a real, publicly-fetchable HTTP(S) URL for the user's photo
# (it rejects inline data: URIs), so we briefly upload it to Cloudinary and
# delete it again once the VModel task settles. Required whenever
# VMODEL_API_KEY is set
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option A — Custom external backend (browser calls this directly, no server hop)
# Set this to your own hair try-on API URL.
# The browser sends: { image, hairstyle, color, length }
# Your backend must return: { "resultImageUrl": "https://..." }
#                        or { "image": "data:image/...;base64,..." }
VITE_EXTERNAL_API_URL=

# Option B — Server-side custom backend (called from the Nitro server, not the browser)
# Same expected request/response format as Option A.
# Use this if your backend should not be directly accessible from the browser.
EXTERNAL_API_URL=

# ==========================================
# Velura Photo Check Backend (FastAPI)
# ==========================================

# URL to the FastAPI backend that validates uploaded photos before try-on generation.
# For local development: http://localhost:8000
# For Docker/Dokploy (same domain via nginx): leave empty — defaults to /api
PHOTO_CHECK_BACKEND_URL=http://localhost:8000

# CORS allowed origins for the FastAPI backend (comma-separated)
# For production set this to your actual domain, e.g: https://yourdomain.com
# For local testing: * (allow all)
ALLOWED_ORIGINS=*
