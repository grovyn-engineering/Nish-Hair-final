# ==========================================
# NishHair Try-On Studio - Dokploy Environment Variables
# ==========================================

# Server Port & Binding (Required for Dokploy / Docker)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# TryItOn Developer API Key (Server-Side Secret)
# Get your API key from https://tryiton.now/app/developer
# Note: If left empty or set to "mock", the server API falls back to mock responses.
TRYITON_API_KEY=your_tryiton_api_key_here

# Custom External Backend (Optional — called directly from the browser)
# If set, the frontend skips the server route and POSTs directly to this URL.
# The browser sends: { image, hairstyle, color, length }
# Your backend should return one of:
#   { "resultImageUrl": "https://..." }   — a URL to the result image
#   { "image": "data:image/...;base64,..." } — a base64-encoded result image
VITE_EXTERNAL_API_URL=

